    "    \"En bÃ¼yÃ¼k derece\": degree_values.max(),\n",
    "    \"Ortalama kÃ¼melenme\": nx.average_clustering(G),\n",
    "    \"GeÃ§iÅŸlilik (transitivity)\": nx.transitivity(G),\n",
    "    \"BileÅŸen sayÄ±sÄ±\": len(component_sizes),\n",
