    "# Zorunlu Ã¶lÃ§Ã¼mler: dÃ¼ÄŸÃ¼m/kenar sayÄ±sÄ±, yoÄŸunluk, derece, kÃ¼melenme ve bileÅŸenler.\n",
    "degrees = dict(G.degree())\n",
    "degree_values = np.array(list(degrees.values()), dtype=float)\n",
